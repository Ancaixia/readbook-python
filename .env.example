# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会上传）
APP_NAME=ReadBook
DATABASE_URL=sqlite:///./readbook.db
DEBUG=true

# Session cookie 签名密钥。生产环境务必改成随机长字符串：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-please

# 微信小程序登录凭证（微信公众平台 → 开发 → 开发管理 → 开发设置）。
# 用于后端用 wx.login 返回的 code 换取 openid。留空则微信登录不可用。
WECHAT_APPID=
WECHAT_SECRET=
